@model IEnumerable<MiniSiniestros.ViewModels.PrestadorMedicoListadoItemViewModel>

@{
    ViewData["Title"] = "Prestadores médicos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Prestadores médicos</h1>

    <a asp-action="Create"
       class="btn btn-primary">
        Nuevo prestador
    </a>
</div>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Nombre</th>
            <th class="text-end">Acciones</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var prestador in Model)
        {
            <tr>
                <td>@prestador.Nombre</td>

                <td class="text-end">
                    <a asp-action="Details"
                       asp-route-id="@prestador.Id"
                       class="btn btn-sm btn-outline-primary">
                        Ver
                    </a>

                    <a asp-action="Edit"
                       asp-route-id="@prestador.Id"
                       class="btn btn-sm btn-outline-warning">
                        Editar
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@prestador.Id"
                       class="btn btn-sm btn-outline-danger">
                        Eliminar
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>