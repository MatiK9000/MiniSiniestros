@model IEnumerable<MiniSiniestros.ViewModels.TrabajadorListadoItemViewModel>

@{
    ViewData["Title"] = "Trabajadores";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Trabajadores</h1>

    <a asp-action="Create" class="btn btn-primary">
        Nuevo trabajador
    </a>
</div>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>CUIL</th>
            <th>Apellido y nombre</th>
            <th class="text-end">Acciones</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var trabajador in Model)
        {
            <tr>
                <td>@trabajador.Cuil</td>
                <td>@trabajador.NombreCompleto</td>

                <td class="text-end">
                    <a asp-action="Details"
                       asp-route-id="@trabajador.Id"
                       class="btn btn-sm btn-outline-primary">
                        Ver
                    </a>

                    <a asp-action="Edit"
                       asp-route-id="@trabajador.Id"
                       class="btn btn-sm btn-outline-warning">
                        Editar
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@trabajador.Id"
                       class="btn btn-sm btn-outline-danger">
                        Eliminar
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>