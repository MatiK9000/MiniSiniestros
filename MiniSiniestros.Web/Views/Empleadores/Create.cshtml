@model MiniSiniestros.ViewModels.EmpleadorFormularioViewModel

@{
    ViewData["Title"] = "Nuevo Empleador";
}

<h1>Nuevo Empleador</h1>

<form asp-action="Create" method="post">

    <div asp-validation-summary="ModelOnly"
         class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Cuit" class="form-label"></label>
        <input asp-for="Cuit" class="form-control" />
        <span asp-validation-for="Cuit" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="RazonSocial" class="form-label"></label>
        <input asp-for="RazonSocial" class="form-control" />
        <span asp-validation-for="RazonSocial"
              class="text-danger"></span>
    </div>

    <button type="submit"
            class="btn btn-primary">
        Guardar
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancelar
    </a>

</form>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}