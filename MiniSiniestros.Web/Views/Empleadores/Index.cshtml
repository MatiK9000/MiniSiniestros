@model IEnumerable<MiniSiniestros.ViewModels.EmpleadorListadoItemViewModel>

@{
    ViewData["Title"] = "Empleadores";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Empleadores</h1>

    <a asp-action="Create"
       class="btn btn-primary">
        Nuevo Empleador
    </a>
</div>

<table class="table table-striped">

    <thead>
        <tr>
            <th>CUIT</th>
            <th>Razón Social</th>
            <th></th>
        </tr>
    </thead>

    <tbody>

        @foreach (var empleador in Model)
        {
            <tr>

                <td>@empleador.Cuit</td>

                <td>@empleador.RazonSocial</td>

                <td>

                    <a asp-action="Details"
                       asp-route-id="@empleador.Id"
                       class="btn btn-sm btn-outline-primary">
                        Ver
                    </a>

                    <a asp-action="Edit"
                       asp-route-id="@empleador.Id"
                       class="btn btn-sm btn-outline-warning">
                        Editar
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@empleador.Id"
                       class="btn btn-sm btn-outline-danger">
                        Eliminar
                    </a>

                </td>

            </tr>
        }

    </tbody>

</table>