@model MiniSiniestros.ViewModels.ErrorNegocioViewModel

@{
    ViewData["Title"] = "No se pudo realizar la operación";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-8 col-lg-6">

        <div class="card border-danger shadow-sm">
            <div class="card-body text-center p-5">

                <div class="display-4 mb-3">
                    ⚠️
                </div>

                <h1 class="h3 text-danger mb-3">
                    No se pudo realizar la operación
                </h1>

                <p class="lead mb-4">
                    @Model.Mensaje
                </p>

                <div class="d-flex justify-content-center gap-2">

                    @if (!string.IsNullOrWhiteSpace(Model.UrlAnterior))
                    {
                        <a href="@Model.UrlAnterior"
                           class="btn btn-outline-secondary">
                            Volver
                        </a>
                    }

                    <a asp-controller="Siniestros"
                       asp-action="Index"
                       class="btn btn-primary">
                        Ir al inicio
                    </a>

                </div>
            </div>
        </div>

    </div>
</div>